# Verilator regression for the CIRA job dispatch protocol.
#
# This is the only part of the Vortex offload path that can be verified without
# Quartus and the board, so it is worth running on every RTL change:
#
#   make -f Makefile.cira_dispatch        # build and run
#   make -f Makefile.cira_dispatch clean

VERILATOR ?= verilator
RTL_DIR   := ../hardware_test_design/common/rv64

TOP     := tb_cira_job_dispatch
SOURCES := $(TOP).sv $(RTL_DIR)/cira_job_dispatch.sv
BIN     := obj_dir/tb_cira

# WIDTH* and INITIALDLY are testbench-side idioms; the DUT itself is checked
# with -Wall by the `lint` target below and must stay clean.
VFLAGS := --binary -j 0 --timing \
          -Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-INITIALDLY

.PHONY: all run lint clean

all: run

$(BIN): $(SOURCES)
	$(VERILATOR) $(VFLAGS) --top-module $(TOP) $(SOURCES) -o tb_cira

run: $(BIN)
	./$(BIN)

lint:
	$(VERILATOR) --lint-only -Wall -Wno-DECLFILENAME \
		--top-module cira_job_dispatch $(RTL_DIR)/cira_job_dispatch.sv

clean:
	rm -rf obj_dir
