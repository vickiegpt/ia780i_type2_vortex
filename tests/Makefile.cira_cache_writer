# Verilator regression for the CXL.cache completion writer.

VERILATOR ?= verilator
RTL_DIR   := ../hardware_test_design/common/rv64

TOP     := tb_cira_cxl_cache_completion_writer
SOURCES := $(TOP).sv $(RTL_DIR)/cira_cxl_cache_completion_writer.sv
BIN     := obj_dir/tb_cira_cache_writer

VFLAGS := --binary -j 0 --timing \
          -Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-INITIALDLY

.PHONY: all run lint clean

all: run

$(BIN): $(SOURCES)
	$(VERILATOR) $(VFLAGS) --top-module $(TOP) $(SOURCES) -o tb_cira_cache_writer

run: $(BIN)
	./$(BIN)

lint:
	$(VERILATOR) --lint-only -Wall -Wno-DECLFILENAME \
		--top-module cira_cxl_cache_completion_writer $(RTL_DIR)/cira_cxl_cache_completion_writer.sv

clean:
	rm -rf obj_dir
